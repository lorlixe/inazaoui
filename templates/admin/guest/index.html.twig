{% extends 'admin.html.twig' %}

{% block admin %}
	<div class="d-flex justify-content-between align-items-center">
		<h1>Invités ({{ total }}
			au total)</h1>
		<a href="{{path("admin_guest_add")}}" class="btn btn-primary">Ajouter</a>
	</div>

	<table class="table">
		<thead>
			<tr>
				<th>Nom</th>
				<th>Status</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for guest in guests %}
				<tr>
					<td>{{ guest.name }}</td>
					<td>
						{% if guest.blocked %}
							<span class="badge bg-danger">Bloqué</span>
						{% else %}
							<span class="badge bg-success">Actif</span>
						{% endif %}
					</td>
					<td>
						{% if guest.blocked %}
							<a href="{{ path('admin_guest_block', {id: guest.id}) }}" class="btn bg-success">Débloquer</a>
						{% else %}
							<a href="{{ path('admin_guest_block', {id: guest.id}) }}" class="btn btn-warning">Bloquer</a>
						{% endif %}

						<a href="{{ path('admin_guest_delete', {id: guest.id}) }}" class="btn btn-danger">Supprimer</a>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	{# Pagination #}
	{% if pages > 1 %}
		<nav aria-label="Pagination des invités" class="mt-4">
			<ul
				class="pagination justify-content-center">
				{# Bouton Précédent #}
				<li class="page-item {% if page == 1 %}disabled{% endif %}">
					<a class="page-link" href="{{ path('admin_guest_index', {page: page - 1}) }}">
						« Précédent
					</a>
				</li>

				{# Numéros de page #}
				{% for p in 1..pages %}
					{# Afficher max 7 pages autour de la page actuelle #}
					{% if p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
						<li class="page-item {% if p == page %}active{% endif %}">
							<a class="page-link" href="{{ path('admin_guest_index', {page: p}) }}">
								{{ p }}
							</a>
						</li>
					{% elseif p == page - 3 or p == page + 3 %}
						<li class="page-item disabled">
							<span class="page-link">...</span>
						</li>
					{% endif %}
				{% endfor %}

				{# Bouton Suivant #}
				<li class="page-item {% if page == pages %}disabled{% endif %}">
					<a class="page-link" href="{{ path('admin_guest_index', {page: page + 1}) }}">
						Suivant »
					</a>
				</li>
			</ul>
		</nav>
	{% endif %}

	{# Afficher l'intervalle actuel #}
	<p class="text-center text-muted">
		Affichage de
		{{ (page - 1) * limit + 1 }}
		à
		{{ min(page * limit, total) }}
		sur
		{{ total }}
		invité(s)
	</p>
{% endblock %}
