{% extends 'front.html.twig' %}

{% block front %}
	<div class="row">
		<div class="col-12">
			<h3 class="mb-5">Invités</h3>
			<div class="guests d-flex flex-column">
				{% for guest in guests %}
					<div class="guest py-5 d-flex justify-content-between align-items-center">
						<h4>{{ guest.name }}
							({{ guest.medias|length }})</h4>
						<a href="{{ path('guest', {id: guest.id}) }}">découvrir</a>
					</div>
				{% endfor %}
				{# Pagination #}
				{% if pages > 1 %}
					<nav aria-label="Navigation des invités" class="mt-4">
						<ul
							class="pagination justify-content-center">
							{# Bouton Précédent #}
							<li class="page-item {% if page == 1 %}disabled{% endif %}">
								<a class="page-link" href="{{ path('guests', {page: page - 1}) }}" aria-label="Précédent">
									<span aria-hidden="true">&laquo;</span>
								</a>
							</li>

							{# Numéros de page #}
							{% for p in 1..pages %}
								{% if p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
									<li class="page-item {% if p == page %}active{% endif %}">
										<a class="page-link" href="{{ path('guests', {page: p}) }}">{{ p }}</a>
									</li>
								{% elseif p == page - 3 or p == page + 3 %}
									<li class="page-item disabled">
										<span class="page-link">...</span>
									</li>
								{% endif %}
							{% endfor %}

							{# Bouton Suivant #}
							<li class="page-item {% if page == pages %}disabled{% endif %}">
								<a class="page-link" href="{{ path('guests', {page: page + 1}) }}" aria-label="Suivant">
									<span aria-hidden="true">&raquo;</span>
								</a>
							</li>
						</ul>
					</nav>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
