{% extends 'front.html.twig' %}

{% block front %}
	<div class="row">
		<div class="col-12">
			<h3 class="mb-4">Portfolio</h3>
			<div class="mb-5 row">
				<div class="col-2">
					<a class="btn w-100 py-3 {{ album is null ? 'active' }}" href="{{ path('portfolio') }}">
						Toutes
					</a>
				</div>
				{% for a in albums %}
					<div class="col-2">
						<a class="btn w-100 py-3 {{ album == a ? 'active' }}" href="{{ path('portfolio', {id: a.id}) }}">
							{{ a.name }}
						</a>
					</div>
				{% endfor %}
			</div>
			<div class="row">
				{% for media in medias %}
					<div class="col-4 media mb-4">
						<img class="w-100" src="{{ asset(media.path) }}" alt="{{ media.title }}" loading="lazy">
						<p class="text-center mb-0 mt-2 media-title">{{ media.title }}</p>
					</div>
				{% endfor %}
				{% if pages > 1 %}
					<nav aria-label="Navigation du portfolio" class="mt-5">
						<ul
							class="pagination justify-content-center">
							{# Précédent #}
							<li class="page-item {% if page == 1 %}disabled{% endif %}">
								<a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: page - 1}) }}">
									&laquo; Précédent
								</a>
							</li>

							{# Numéros de page #}
							{% for p in 1..pages %}
								{% if p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
									<li class="page-item {% if p == page %}active{% endif %}">
										<a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: p}) }}">
											{{ p }}
										</a>
									</li>
								{% elseif p == page - 3 or p == page + 3 %}
									<li class="page-item disabled">
										<span class="page-link">...</span>
									</li>
								{% endif %}
							{% endfor %}

							{# Suivant #}
							<li class="page-item {% if page == pages %}disabled{% endif %}">
								<a class="page-link" href="{{ path('portfolio', {id: album ? album.id : null, page: page + 1}) }}">
									Suivant &raquo;
								</a>
							</li>
						</ul>
					</nav>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
